<mvc:View controllerName="codecl3.preticeui502.controller.prectice2_cl3_ui502"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:t="sap.ui.table"
    >
    <Page id="page" title="{i18n>title}">
        <Panel >
            <t:Table    id="second"
                        rows="{/ScheduleSet}"
                        visibleRowCount=""
                        selectionMode="None"
                        class="sapUiResponsiveContentPadding"
                        showColumnVisibilityMenu="true"
                        alternateRowColors="true"
            >
                <t:extension>
                    <OverflowToolbar >
                        <Title text="2번째 데이터"/>
                            <ToolbarSpacer />
                                <Input id="word" placeholder="Carrid" width="10rem" />
                                <Input id="word2" placeholder="Connid" width="10rem" />
                                <Button id="btn1" icon="sap-icon://search" type="Ghost" press="onSearch" />
                    </OverflowToolbar>
                    
                </t:extension>
                    <t:columns>
                    <t:Column >
                        <Text text="Carrid"/>
                        <t:template>
                            <Text text="{Carrid}"/>
                        </t:template>
                    </t:Column>
                    <t:Column >
                        <Text text="Connid"/>
                        <t:template>
                            <Text text="{Connid}"/>
                        </t:template>
                    </t:Column>
                    <t:Column >
                        <Text text="Countryfr"/>
                        <t:template>
                            <Text text="{Countryfr}"/>
                        </t:template>
                    </t:Column>
                    <t:Column >
                        <Text text="Cityfrom"/>
                        <t:template>
                            <Text text="{Cityfrom}"/>
                        </t:template>
                    </t:Column>
                    <t:Column >
                        <Text text="Countryto"/>
                        <t:template>
                            <Text text="{Countryto}"/>
                        </t:template>
                    </t:Column>
                    <t:Column >
                        <Text text="Cityto"/>
                        <t:template>
                            <Text text="{Cityto}"/>
                        </t:template>
                    </t:Column>
                    <t:Column >
                        <Text text="Fltime"/>
                        <t:template>
                            <Text text="{Fltime}"/>
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </Panel>

    </Page>
</mvc:View>