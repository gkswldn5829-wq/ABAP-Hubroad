<mvc:View controllerName="code.cl3.exampm.controller.exam_pm"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:mc="sap.suite.ui.microchart"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    >
    <Page id="page" title="{i18n>title}">

        <Panel  headerText="문제 6번" 
                width="150px">
            <Button text="Click" type="Unstyled" press="onPress"/>
        </Panel>
<Bar class="sapUiSmallMargin" />
        <Panel  >
            <t:Table    id="table"
                        selectionMode="MultiToggle"
                        rows="{server1>/GridSet}"
                        filter="filterPrice"
                        ariaLabelledBy="title"
                        width="auto"
                        alternateRowColors="true"
            >
                <t:extension>
                    <OverflowToolbar style="Clear">
                        <Title id="title" text="문제 7번"/>
                            <ToolbarSpacer />
                            <ToolbarSeparator/>

                        <SearchField
                            placeholder="Company name Search"
                            search="onSearch"
                            width="285px"/>

                    </OverflowToolbar>
                </t:extension>
                    <t:columns>
                        <t:Column>
                            <Label text="Company Code" />
                            <t:template>
                                <Text text="{server1>Burks}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Fiscal year" />
                            <t:template>
                                <Text text="{server1>Gjahr}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Company name" />
                            <t:template>
                                <Text text="{server1>Bktxt}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="Asset total" />
                            <t:template>
                                <Text text="{server1>Anlnl}" wrapping="false" />
                            </t:template>
                        </t:Column>
                    </t:columns>
            </t:Table>
        </Panel>
<Bar class="sapUiSmallMargin" />
            <Panel  >
                <t:Table    id="table2"
                            selectionMode="MultiToggle"
                            rows="{server2>/DataSet}"
                            filter="filterPrice"
                            ariaLabelledBy="title"
                            width="auto"
                            alternateRowColors="true"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title text="문제 8번"/>
                                <ToolbarSpacer />
                                <ToolbarSeparator/>

                            <SearchField
                                placeholder="Comp Search"
                                search="onSearch2"
                                width="285px"/>

                        </OverflowToolbar>
                    </t:extension>
                        <t:columns>
                            <t:Column>
                                <Label text="year" />
                                <t:template>
                                    <Text text="{server2>year}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column>
                                <Label text="Comp" />
                                <t:template>
                                    <Text text="{server2>Comp}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column>
                                <Label text="Asset" />
                                <t:template>
                                    <Text text="{server2>Asset}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Gubun" />
                                <t:template>
                                    <Text text="{server2>Gubun}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Total" />
                                <t:template>
                                    <Text text="{server2>Total}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="List" />
                                <t:template>
                                    <Text text="{server2>List}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Rate" />
                                <t:template>
                                    <Text text="{server2>Rate}" wrapping="false" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Increase" />
                                <t:template>
                                    <Text text="{server2>Increase}" wrapping="false" />
                                </t:template>
                            </t:Column>
                        </t:columns>
                </t:Table>
            </Panel>
<Bar class="sapUiSmallMargin" />
    <HBox >
            <Panel  class="sapUiResponsiveMargin" 
                    width="auto">
                <viz:VizFrame   uiConfig="{applicationSet:'fiori'}"
                                height='20rem' 
                                width="32rem" 
                                vizType='donut'
                                vizProperties="{ title: {text : '9번 1번째 비즈프레임차트', visible : true}}">

                    <viz:dataset>
                        <viz.data:FlattenedDataset data= "{server3>/VizSet}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition   name="야구선수"
                                                                value="{server3>player}" />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition name="Assist"
                                                            value="{=parseFloat(${server3>Assist})}"/>
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                       <viz.feeds:FeedItem  uid="color"
                                            type="Dimension"
                                            values="야구선수"
                        />
                        <viz.feeds:FeedItem uid="size"
                                            type="Measure"
                                            values="Assist"
                        />
                    </viz:feeds>
                </viz:VizFrame>
            </Panel>
            <Panel  class="sapUiResponsiveMargin" 
                    width="auto"
            >
                <viz:VizFrame   uiConfig="{applicationSet:'fiori'}"
                                height='20rem' 
                                width="32rem" 
                                vizType='bar'
                                vizProperties="{ title: {text : '9번 2번째 비즈프레임차트', visible : true}}"
                >
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{server3>/VizSet}" >
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition   name="야구선수이름"
                                                                value="{server3>player}"/>
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition name="어시스트횟수"
                                                            value="{=parseFloat(${server3>Assist})}"/>
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem uid="valueAxis"
                                            type="Measure"
                                            values="어시스트횟수"
                        />
                        <viz.feeds:FeedItem uid="categoryAxis"
                                            type="Dimension"
                                            values="야구선수이름"
                        />
                    </viz:feeds>
                </viz:VizFrame>
            </Panel>
    </HBox>


<Bar class="sapUiSmallMargin" />
    <HBox >
        <Panel  width="700px"
                height="250px"
                headerText="문제 10번 1번째 차트"
        >
            <FlexBox    width="30rem" 
                        height="10rem" 
                        alignItems="Center" 
                        class="sapUiSmallMargin"
            >
                <items>
                    <mc:InteractiveDonutChart   selectionChanged="onSelectionChanged"
                                                segments="{server4>/MicroSet}"
                                                displayedSegments="5"
                    >
                        <mc:segments>
                            <mc:InteractiveDonutChartSegment    label="{server4>team}"
                                                                value="{server4>Homerun}"
                                                                />
                        </mc:segments>
                    </mc:InteractiveDonutChart>
                </items>
            </FlexBox>
        </Panel>
        <Panel  width="700px"
                height="250px"
                headerText="문제 10번 2번째 차트"
        >
            <FlexBox    width="30rem" 
                        height="10rem" 
                        alignItems="Center" 
                        class="sapUiSmallMargin"
            >
                <items>
                    <mc:InteractiveLineChart  selectionChanged="selectionChanged" 
                                                points="{server4>/MicroSet}"
                                                >
                        <mc:points>
                            <mc:InteractiveLineChartPoint   label="{server4>team}"
                                                            value="{server4>Homerun}"
                            />
                        </mc:points>
                    </mc:InteractiveLineChart>
                </items>
            </FlexBox>
        </Panel>
    </HBox>
<Bar class="sapUiSmallMargin" />
    <FlexBox
        justifyContent="Center"
        alignItems="Center"
        class="sapUiSmallMarginTop"
    >
        <Panel headerText="Calculator_문제11번" class="sapUiResponsiveMargin" width="14rem">
            <VBox >
                <Input id="text" width="12rem" editable="false"/>
                <HBox >
                    <Button id="7" text="7" press="setNumber('7')" width="3rem"/>
                    <Button id="8" text="8" press="setNumber('8')" width="3rem"/>
                    <Button id="9" text="9" press="setNumber('9')" width="3rem"/>
                    <Button id="div" text="/" press="setNumber('/')" width="3rem" type="Accept"/>
                </HBox>
                <HBox >
                    <Button id="4" text="4" press="setNumber('4')" width="3rem"/>
                    <Button id="5" text="5" press="setNumber('5')" width="3rem"/>
                    <Button id="6" text="6" press="setNumber('6')" width="3rem"/>
                    <Button id="x" text="x" press="setNumber('*')" width="3rem" type="Attention"/>
                </HBox>
                <HBox >
                    <Button id="1" text="1" press="setNumber('1')" width="3rem"/>
                    <Button id="2" text="2" press="setNumber('2')" width="3rem"/>
                    <Button id="3" text="3" press="setNumber('3')" width="3rem"/>
                    <Button id="-" text="-" press="setNumber('-')" width="3rem" type="Emphasized"/>
                </HBox>
                <HBox >
                    <Button id="ok"  text="="   press="setNumber('eq')" width="3rem" type="Unstyled"/>
                    <Button id="clr" text="CLR" press="setNumber('')"   width="3rem" type="Unstyled"/>
                    <Button id="zero" text="0"  press="setNumber('0')"  width="3rem"/>
                    <Button id="plus" text="+" press="setNumber('+')" width="3rem" type="Accept"/>
                </HBox>
            </VBox>
        </Panel>
    </FlexBox>
        
        <Panel  class="sapUiResponsiveMargin"
                    expandable="true" 
                    headerText="First View"
                    width="10rem"
            >
                <Text text="12번 문제 "/>
                <Button text="Go Second" 
                        icon="sap-icon://cargo-train"
                        press="goSecond"
                />
        </Panel>


    </Page>
</mvc:View>