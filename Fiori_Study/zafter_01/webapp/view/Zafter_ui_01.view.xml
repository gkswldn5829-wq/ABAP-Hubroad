<mvc:View controllerName="zcl327.zafter01.controller.Zafter_ui_01"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls" 
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    height="100%">
    <Page id="page" title="{i18n>title}">
        <VBox >
            <HBox >
                <Panel  id="id1"
                    class="sapUiResponsiveMargin"
                    headerText="Odata" 
                    width="auto">
                    <t:Table
                    id="Table" 
                    rows="{/FlySet}"
                    selectionMode="MultiToggle"
                    visibleRowCount = '4'
                    width="auto">
                        <t:extension>
                            <OverflowToolbar >
                                <Title text="EKKO Odata"/>
                                    <ToolbarSpacer />
                                    <Input id="word"  placeholder="Code" width="10rem" />
                                    <Input id="word2" placeholder="Name" width="10rem" />
                                    <Button id="btn1" icon="sap-icon://search" type="Ghost" press="onSearch" />
                                <ToolbarSeparator/>
                                <SearchField
                                placeholder="입력하세요"
                                search="filterGlobally"
                                width="285px"/>
                            </OverflowToolbar>
                        </t:extension>
                    
                        <t:columns>
                            <t:Column width="auto">
                                <Label text="carrid" />
                                    <t:template>
                                        <Text text="{carrid}" wrapping="false"/>
                                    </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="connid" />
                                    <t:template>
                                        <Text text="{connid}" wrapping="false"/>
                                    </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="Fldate" />
                                    <t:template>
                                        <Text text="{Fldate}" wrapping="false"/>
                                    </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="bookid" />
                                    <t:template>
                                        <Text text="{bookid}" wrapping="false"/>
                                    </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="Deptime" />
                                    <t:template>
                                        <Text text="{Deptime}" wrapping="false"/>
                                    </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="customid" />
                                    <t:template>
                                        <Text text="{customid}" wrapping="false"/>
                                    </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="Foreign Amount" />
                                <t:template>
                                    <Text text="{ 
                                        parts:[{path:'luggweight'},{path:'wunit'}],
                                        type: 'sap.ui.model.type.Currency',
                                        formatOptions: {showMeasure: true }
                                        }" wrapping="false"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="auto">
                                <Label text="Distance" />
                                <t:template>
                                    <Text text="{
                                        parts:[{path:'forcuram'},{path:'forcurkey'}],
                                        type: 'sap.ui.model.type.Unit',
                                        formatOptions: {showMeasure: true }
                                        }" wrapping="false" />
                                </t:template>
                            </t:Column>
                        </t:columns>
                 </t:Table>
                </Panel>
            </HBox>
                <Panel 
                    id="id2"
                    class="sapUiResponsiveMargin"
                    headerText="Odata" 
                    width="auto">
                    <smartTable:SmartTable id="LineItemsSmartTable" entitySet="FlySet" smartFilterId="smartFilterBar" tableType="Table" 
                        useExportToExcel="true" beforeExport="onBeforeExport" useVariantManagement="true" useTablePersonalisation="true"
                        header="Line Items" showRowCount="true" persistencyKey="SmartTableAnalytical_Explored" 
                        enableAutoBinding="true" class="sapUiResponsiveContentPadding" enableAutoColumnWidth="true"
                        editTogglable="true" app:useSmartToggle="true" width="auto"
                        initiallyVisibleFields="carrid,connid,Fldate,bookid,Deptime,customid,luggweight,forcuram">
                        <!-- layout data used to make the table growing but the filter bar fixed -->
                        <smartTable:layoutData>
                            <FlexItemData growFactor="1" baseSize="0%"/>
                        </smartTable:layoutData>
                    </smartTable:SmartTable>
                </Panel>
        </VBox>
    </Page>
</mvc:View>