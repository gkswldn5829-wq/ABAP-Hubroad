<mvc:View 
    xmlns:data="sap.viz.ui5.data" controllerName="code.cl3.precticeui505.controller.prectice_ui5_05"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:layout="sap.ui.layout"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:form="sap.ui.layout.form"
    >
    <Page id="page" title="{i18n>title}" class="sapUiResponsiveContentPadding" >
        <HBox >
            <Panel backgroundDesign="Translucent"
            >
                <t:Table    id="table1"
                            rows="{/AirlineSet}"    
                            ariaLabelledBy="1번 차트"
                            class="sapUiResponsiveContentPadding"
                            showColumnVisibilityMenu="true"
                            alternateRowColors="true"
                            visibleRowCount="8"
                >
                    <t:extension>
                        <OverflowToolbar >
                            <Title text= "첫번째 차트" />
                                <ToolbarSpacer />
                                    <SearchField    width="150px"
                                                    placeholder="뱅기이름"
                                                    search="onSearch"/>
                        </OverflowToolbar>
                    </t:extension>
                        <t:columns>
                            <t:Column >
                                <Label text="항공사ID"/>
                                <t:template>
                                    <Text text="{Carrid}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="뱅기이름"/>
                                <t:template>
                                    <Text text="{Carrname}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="코드정보"/>
                                <t:template>
                                    <Text text="{Currcode}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="항공사홈페이지"/>
                                <t:template>
                                    <Text text="{Url}" />
                                </t:template>
                            </t:Column>
                        </t:columns>
                </t:Table>
            </Panel>

            <Panel  backgroundDesign="Solid"
                    class="sapUiSmallMarginBegin"
            >
                <t:Table    rows="{server2>/ScheduleSet}"
                            id="table3"   
                            class="sapUiResponsiveContentPadding"
                            showColumnVisibilityMenu="true"
                            alternateRowColors="true"
                            visibleRowCount="7"
                            

                >
                    <t:extension>
                        <OverflowToolbar >
                            <Title text= "두번째 차트" />
                                <ToolbarSpacer />
                                    <Input id="input1" placeholder="Carrid" width="100px"/>
                                    <Input id="input2" placeholder="Connid" width="100px" />
                                    <Button text="search" icon="sap-icon://camera" press="onSearch2" />
                        </OverflowToolbar>
                    </t:extension>
                    <t:columns>
                        <t:Column >
                            <Label text="항공사ID"/>
                            <t:template>
                                <Text text="{server2>Carrid}" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="Connid"/>
                            <t:template>
                                <Text text="{server2>Connid}" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="코드정보"/>
                            <t:template>
                                <Text text="{server2>Countryfr}" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="항공사홈페이지"/>
                            <t:template>
                                <Text text="{server2>Cityfrom}" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="항공사홈페이지"/>
                            <t:template>
                                <Text text="{server2>Countryto}" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="항공사홈페이지"/>
                            <t:template>
                                <Text text="{server2>Cityto}" />
                            </t:template>
                        </t:Column>
                        <t:Column >
                            <Label text="항공사홈페이지"/>
                            <t:template>
                                <Text text="{server2>Fltime}" />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </HBox>

        <Panel  height="500px"
                width="800px"
                class="sapUiSmallMarginTop" 
        >
            <viz:VizFrame   id="viz2"
                            uiConfig="{applicationSet:'fiori'}"
                            height="500px"
                            width="700px"
                            vizType="area"
            >
                <viz:dataset>
                    <data:FlattenedDataset data="{server3>/PaymentSet}">
                        <data:dimensions>
                            <data:DimensionDefinition   name="아이디"
                                                        value="{server3>Carrid}"
                            />
                        </data:dimensions>
                        <data:measures>
                            <data:MeasureDefinition name="가격"
                                                    value="{server3>Price}" 
                            />
                        </data:measures>
                    </data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem id='valueAxisFeed' 
                                        uid="valueAxis" 
                                        type="Measure"
                                        values="가격" 
                    />
                    <viz.feeds:FeedItem id='categoryAxisFeed' 
                                        uid="categoryAxis" 
                                        type="Dimension"
                                        values="아이디" 
                    />
                </viz:feeds>
            </viz:VizFrame>
        </Panel>
        
        <Panel  backgroundDesign="Translucent"
                class="sapUiSmallMarginTop"
            >
                <t:Table    id="table4"
                            rows="{server3>/FlightSet}"    
                            ariaLabelledBy="4번 차트"
                            class="sapUiResponsiveContentPadding"
                            showColumnVisibilityMenu="true"
                            alternateRowColors="true"
                            visibleRowCount="8"
                >
                    <t:extension>
                        <OverflowToolbar >
                            <Title text= "4번째 차트" />
                                <ToolbarSpacer />
                                    <SearchField    width="150px"
                                                    placeholder="콘 아이디"
                                                    search="onSearch3"/>
                        </OverflowToolbar>
                    </t:extension>
                        <t:columns>
                            <t:Column >
                                <Label text="항공사ID"/>
                                <t:template>
                                    <Text text="{server3>Carrid}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Connid"/>
                                <t:template>
                                    <Text text="{server3>Connid}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Fldate"/>
                                <t:template>
                                    <Text text="{server3>Fldate}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Price"/>
                                <t:template>
                                    <Text text="{server3>Price}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Currency"/>
                                <t:template>
                                    <Text text="{server3>Currency}" />
                                </t:template>
                            </t:Column>
                            <t:Column >
                                <Label text="Planetype"/>
                                <t:template>
                                    <Text text="{server3>Planetype}" />
                                </t:template>
                            </t:Column>
                        </t:columns>
                </t:Table>
            </Panel>

    </Page>
</mvc:View>