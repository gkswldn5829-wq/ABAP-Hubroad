<mvc:View controllerName="cl3.jiwoo.purchasing.controller.PurchasingView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls" 
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    height="100%"
    >
    <Page id="page" title="{i18n>title}">
        <VBox >
            <Panel  id="id1"
                    class="sapUiResponsiveMargin"
                    headerText="Odata" 
                    width="auto"
                    >
                <t:Table
                    id="Table" 
                    rows="{/JiwooSet}"
                    selectionMode="MultiToggle"
                    visibleRowCount = '4'
                    width="auto"
                    >
                    <t:extension>
                        <OverflowToolbar >
                            <Title text="EKKO Odata"/>
                                <ToolbarSpacer />
                                <Input id="word"  placeholder="Code" width="10rem" />
                                <Input id="word2" placeholder="Name" width="10rem" />
                                <Button id="btn1" icon="sap-icon://search" type="Ghost" press="onSearch" />
                            <ToolbarSeparator/>
                            <SearchField
                            placeholder="입력하세요"
                            search="filterGlobally"
                            width="285px"/>
                        </OverflowToolbar>
                    </t:extension>
                    
                    <t:columns>
                        <t:Column width="auto">
                            <Label text="ebeln" />
                                <t:template>
                                    <Text text="{ebeln}" wrapping="false"/>
                                </t:template>
                        </t:Column>
                        <t:Column width="auto">
                            <Label text="bukrs" />
                                <t:template>
                                    <Text text="{bukrs}" wrapping="false"/>
                                </t:template>
                        </t:Column>
                        <t:Column width="auto">
                            <Label text="bstyp" />
                                <t:template>
                                    <Text text="{bstyp}" wrapping="false"/>
                                </t:template>
                        </t:Column>
                        <t:Column width="auto">
                            <Label text="bsart" />
                                <t:template>
                                    <Text text="{bsart}" wrapping="false"/>
                                </t:template>
                        </t:Column>
                        <t:Column width="auto">
                            <Label text="bsakz" />
                                <t:template>
                                    <Text text="{bsakz}" wrapping="false"/>
                                </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

                <Panel 
                    width="auto"
                    class="sapUiResponsiveMargin"
                    headerText="Odata" >
                    <viz:VizFrame   
                                id="idVizFrame" 
                                uiConfig="{applicationSet:'fiori'}"
                                height='30rem' 
                                width="auto" 
                                vizType='bubble'
                                
                                vizProperties="{ title: {text : 'Airline', visible : true}}">
                        <viz:dataset>
                            <viz.data:FlattenedDataset data="{Chart>/ChartSet}">
                                <viz.data:dimensions>
                                    <viz.data:DimensionDefinition name="Airline"
                                                                value="{Chart>carrid}" />
                                </viz.data:dimensions>
                                <viz.data:measures>
                                    <viz.data:MeasureDefinition name="Max Seats"
                                                                value="{Chart>seatsmax}" />
                                    <viz.data:MeasureDefinition name="Seats Occupied"
                                                                value="{Chart>seatsocc}" />
                                </viz.data:measures>
                            </viz.data:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <viz.feeds:FeedItem uid="valueAxis" type="Measure"
                                                values="Max Seats" />
                            <viz.feeds:FeedItem uid="valueAxis2" type="Measure"
                                                values="Seats Occupied" />
                            <viz.feeds:FeedItem uid="bubbleWidth" type="Measure"
                                                values="Seats Occupied" />
                            <viz.feeds:FeedItem uid="color" type="Dimension"
                                                values="Airline" />
                        </viz:feeds>
                        <viz:dependents>
                            <viz:Popover id="idPopOver"/>
                        </viz:dependents>
                    </viz:VizFrame>
                </Panel>
        </VBox>
    </Page>
</mvc:View>