<mvc:View controllerName="zcl327.ztest01.controller.ztest_01"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">
        <Panel  id="id1"
                        class="sapUiResponsiveMargin"
                        headerText="Odata" 
                        width="auto">
                        <t:Table
                        id="Table" 
                        rows="{/HomeShoppingSet}"
                        selectionMode="Single"
                        visibleRowCount = '6'
                        width="auto">
                            <t:extension>
                                <OverflowToolbar >
                                    <Title text="Home Shopping"/>
                                        <Button id="btn1" icon="sap-icon://search" type="Ghost" press="onSearch" text="Search"/>
                                        <Input id="word"  placeholder="Remark" width="10rem" />
                                        <Input id="word2" placeholder="Document number" width="10rem" />
                                    <ToolbarSeparator/>
                                </OverflowToolbar>
                            </t:extension>
                        
                            <t:columns>
                                <t:Column width="auto">
                                    <Label text="Ryear" />
                                        <t:template>
                                            <Text text="{Ryear}" wrapping="false"/>
                                        </t:template>
                                </t:Column>
                                <t:Column width="auto">
                                    <Label text="Rbukrs" />
                                        <t:template>
                                            <Text text="{Rbukrs}" wrapping="false"/>
                                        </t:template>
                                </t:Column>
                                <t:Column width="auto">
                                    <Label text="Belnr" />
                                        <t:template>
                                            <Text text="{Belnr}" wrapping="false"/>
                                        </t:template>
                                </t:Column>
                                <t:Column width="auto">
                                    <Label text="Racct" />
                                        <t:template>
                                            <Text text="{Racct}" wrapping="false"/>
                                        </t:template>
                                </t:Column>
                                <t:Column width="auto">
                                    <Label text="Remark" />
                                        <t:template>
                                            <Text text="{Remark}" wrapping="false"/>
                                        </t:template>
                                </t:Column>
                                <t:Column width="auto">
                                    <Label text="Hsl" />
                                    <t:template>
                                        <Text text="{ 
                                            parts:[{path:'Hsl'},{path:'Rtcur'}],
                                            type: 'sap.ui.model.type.Currency',
                                            formatOptions: {showMeasure: true }
                                            }" wrapping="false"/>
                                    </t:template>
                                </t:Column>
                                <t:Column width="auto">
                                    <Label text="PostYn" />
                                        <t:template>
                                            <Text text="{PostYn}" wrapping="false"/>
                                        </t:template>
                                </t:Column>
                            </t:columns>
                    </t:Table>
                    </Panel>
                     <Panel class="sapUiResponsiveMargin" width="660px">
                <MessageStrip showIcon="true" text="Data control" showCloseButton="false" />
                <OverflowToolbar >
                    <ToolbarSpacer />
                    <Button text="Display" type="Accept" icon="sap-icon://detail-view" press="onDisplay" />
                    <Button text="Create"  type="Attention" icon="sap-icon://create" press="onCreate"/>
                    <Button text="Update"  type="Attention" icon="sap-icon://write-new-document" press="onUpdate"/>
                    <Button text="Delete"  type="Accept" icon="sap-icon://delete" press="onDelete" />
                </OverflowToolbar>
                <f:SimpleForm layout="ResponsiveGridLayout" title="Content">
                    <f:content>
                        <Label text="총 계정원정 회계연도" />
                        <Input id="Ryear" width="10rem"/>
                        <Label text="회사코드" />
                        <Input id="Rbukrs" width="10rem"/>
                        <Label text="회계전표번호" />
                        <Input id="Belnr" width="4rem"/>
                        <Label text="계정번호" />
                        <Input id="Racct" width="13rem"/>
                        <Label text="비고" />
                        <Input id="Remark" width="13rem"/>
                        <Label text="Hsl" />
                        <Input id="Hsl" width="5rem"/>
                        <Label text="PostYn" />
                        <Input id="PostYn" width="5rem"/>
                    </f:content>
                </f:SimpleForm>
            </Panel>
    </Page>
</mvc:View>